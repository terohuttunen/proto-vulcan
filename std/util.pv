// Utility Relations
// Helpful utility relations for common tasks

// Ordering relation - x is immediately to the left of y in ordered list l
pub rel lefto(x, y, l) {
    l == [x, y | _];
    |head, rest| {
        l == [head | rest],
        head != x,
        lefto(x, y, rest)
    }
}

// Righto relation - x is immediately to the right of y in ordered list l  
pub rel righto(x, y, l) {
    lefto(y, x, l)
}

// Next to relation - x and y are adjacent in list l (either order)
pub rel nextto(x, y, l) {
    conde {
        lefto(x, y, l),
        righto(x, y, l)
    }
}

// At position relation - x is at position n in list l (0-indexed)
pub rel at_position(l, n, x) {
    l == [x | _], n == 0;
    |head, rest| {
        l == [head | rest],
        n == 1,
        at_position(rest, 0, x)
    };
    |head, rest| {
        l == [head | rest],
        n == 2,
        at_position(rest, 1, x)
    };
    |head, rest| {
        l == [head | rest],
        n == 3,
        at_position(rest, 2, x)
    }
}

// Contains relation - l1 contains all elements of l2
pub rel contains(l1, l2) {
    l2 == [];
    |head, rest| {
        l2 == [head | rest],
        member(head, l1),
        contains(l1, rest)
    }
}

// Subset relation - l1 is a subset of l2
pub rel subset(l1, l2) {
    contains(l2, l1)
}

// Equal sets relation - l1 and l2 contain the same elements (order doesn't matter)
pub rel equal_sets(l1, l2) {
    subset(l1, l2),
    subset(l2, l1)
} 