// Environment Variables Module
// Core environment access for reading environment variables and system info

use std::path::{join_path};
use std::list::{first, member};

// Result type for operations that can fail
pub enum EnvResult {
    Ok(LTerm),
    Err(String)
}

// Helper to extract successful results
pub rel env_ok(env_result, value) {
    env_result == EnvResult::Ok(value)
}

// Helper to check for errors
pub rel env_error(env_result, error_msg) {
    env_result == EnvResult::Err(error_msg)
}

// =============================================================================
// ENVIRONMENT VARIABLE OPERATIONS
// =============================================================================

// Get environment variable value
// Usage: env_var("HOME", Value) -> Value is string or fails if not set
pub rel env_var(name, value) {
    __builtin_env_var(name, value)
}

// Get environment variable with default value
// Usage: env_var_or_default("EDITOR", "vim", Value) -> Value is string
pub rel env_var_or_default(name, default_value, value) {
    any {
        // Try to get the environment variable
        env_var(name, value),
        // Use default if not set
        all {
            |test_value| {
                any {
                    all { env_var(name, test_value), false },
                    true
                }
            },
            value == default_value
        }
    }
}

// Get environment variable with EnvResult wrapping
// Usage: env_var_result("HOME", Result) -> Result is EnvResult::Ok(value) or EnvResult::Err(msg)
pub rel env_var_result(name, result) {
    any {
        // Success case: variable exists
        |value| {
            all {
                env_var(name, value),
                result == EnvResult::Ok(value)
            }
        },
        // Error case: variable doesn't exist
        all {
            |test_value| {
                any {
                    all { env_var(name, test_value), false },
                    true
                }
            },
            result == EnvResult::Err("Environment variable not found")
        }
    }
}

// Check if environment variable is set (exists)
// Usage: env_var_exists("PATH") -> succeeds if PATH is set
pub rel env_var_exists(name) {
    |value| {
        env_var(name, value)
    }
}

// =============================================================================
// SYSTEM INFORMATION
// =============================================================================

// Get current working directory
// Usage: current_dir(Dir) -> Dir is string path
pub rel current_dir(dir) {
    __builtin_current_dir(dir)
}

// Get current user's home directory
// Usage: home_dir(Home) -> Home is string path
pub rel home_dir(home) {
    env_var("HOME", home)
}

// Get executable directory (where the current program is located)
// Usage: exe_dir(Dir) -> Dir is string path
pub rel exe_dir(dir) {
    __builtin_exe_dir(dir)
}

// Get system temporary directory
// Usage: temp_dir(Dir) -> Dir is string path
pub rel temp_dir(dir) {
    __builtin_temp_dir(dir)
}

// =============================================================================
// PATH RESOLUTION WITH ENVIRONMENT
// =============================================================================

// Expand environment variables in a path string
// Usage: expand_path("$HOME/.config", ExpandedPath) -> ExpandedPath with $HOME resolved
pub rel expand_path(path, expanded) {
    __builtin_expand_path(path, expanded)
}

// Resolve path relative to home directory
// Usage: home_relative("Documents/file.txt", FullPath) -> FullPath is "$HOME/Documents/file.txt"
pub rel home_relative(relative_path, full_path) {
    |home| {
        home_dir(home),
        join_path(home, relative_path, full_path)
    }
}

// Find executable in PATH
// Usage: which("ls", ExecutablePath) -> ExecutablePath is full path to ls executable
pub rel which(program, executable_path) {
    __builtin_which(program, executable_path)
}

// =============================================================================
// CONVENIENCE PREDICATES
// =============================================================================

// Get config directory (follows XDG spec on Unix, AppData on Windows)
// Usage: config_dir(ConfigDir) -> ConfigDir is platform-appropriate config directory
pub rel config_dir(dir) {
    any {
        // Try XDG_CONFIG_HOME first
        env_var("XDG_CONFIG_HOME", dir),
        // Fall back to HOME/.config
        |home| {
            home_dir(home),
            join_path(home, ".config", dir)
        }
    }
}

// Get data directory (follows XDG spec on Unix, AppData on Windows)
// Usage: data_dir(DataDir) -> DataDir is platform-appropriate data directory
pub rel data_dir(dir) {
    any {
        // Try XDG_DATA_HOME first
        env_var("XDG_DATA_HOME", dir),
        // Fall back to HOME/.local/share
        |home, local| {
            home_dir(home),
            join_path(home, ".local", local),
            join_path(local, "share", dir)
        }
    }
}

// Get cache directory (follows XDG spec on Unix, temp on Windows)
// Usage: cache_dir(CacheDir) -> CacheDir is platform-appropriate cache directory
pub rel cache_dir(dir) {
    any {
        // Try XDG_CACHE_HOME first
        env_var("XDG_CACHE_HOME", dir),
        // Fall back to HOME/.cache
        |home| {
            home_dir(home),
            join_path(home, ".cache", dir)
        }
    }
}

// =============================================================================
// ENVIRONMENT INSPECTION
// =============================================================================

// List all environment variables as key-value pairs
// Usage: env_vars(List) -> List is [(key, value), ...]
pub rel env_vars(vars) {
    __builtin_env_vars(vars)
}

// Get number of environment variables
// Usage: env_var_count(Count) -> Count is integer
pub rel env_var_count(count) {
    |vars| {
        env_vars(vars),
        __builtin_length(vars, count)
    }
}

// =============================================================================
// COMMAND LINE ARGUMENTS
// =============================================================================

// Get all command line arguments (including program name)
// Usage: argv(Args) -> Args is list of strings [program_name, arg1, arg2, ...]
pub rel argv(args) {
    __builtin_argv(args)
}

// Get just the arguments (excluding program name)
// Usage: args(Args) -> Args is list of strings [arg1, arg2, ...]
pub rel args(args) {
    |all_args, program_name| {
        argv(all_args),
        all_args == [program_name | args]
    }
}

// Get program name (first element of argv)
// Usage: program_name(Name) -> Name is string
pub rel program_name(name) {
    |all_args| {
        argv(all_args),
        first(all_args, name)
    }
}

// Get number of command line arguments (including program name)
// Usage: argv_count(Count) -> Count is integer
pub rel argv_count(count) {
    |args| {
        argv(args),
        __builtin_length(args, count)
    }
}

// Get number of arguments (excluding program name)
// Usage: arg_count(Count) -> Count is integer  
pub rel arg_count(count) {
    |args| {
        args(args),
        __builtin_length(args, count)
    }
}

// Check if a specific flag exists in arguments
// Usage: has_flag("--verbose") -> succeeds if --verbose is present
pub rel has_flag(flag) {
    |args| {
        args(args),
        member(flag, args)
    }
}

// Note: More advanced argument parsing utilities like get_option_value  
// will be added when string manipulation predicates are available

// =============================================================================
// TESTS
// =============================================================================

// Test EnvResult enum construction and helper functions
@test(expected = ["test_value"])
rel test_env_result_ok_extraction(value) {
    |result| {
        result == EnvResult::Ok("test_value"),
        env_ok(result, value)
    }
}

@test(expected = ["test_error"])
rel test_env_result_error_extraction(error) {
    |result| {
        result == EnvResult::Err("test_error"),
        env_error(result, error)
    }
}

// Basic tests are in tests/env_tests.pv