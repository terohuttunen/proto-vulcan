// List Processing Relations
// Common relations for working with lists

// Member relation - checks if x is a member of list l
pub rel member(x, l) {
    match l {
        [head | _] => head == x,
        [_ | rest] => member(x, rest)
    }
}

// Check membership in empty list → no results
@test(expected = [])
rel member_test_1(q) {
    member(q, [])
}

// Find all members of [1, 2, 3] → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_2(q) {
    member(q, [1, 2, 3])
}

// Test member with any block (same as member_test_2) → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_3(q) {
    any {
        member(q, [1, 2, 3])
    }
}

// Test member with all block (same as member_test_2) → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_4(q) {
    all {
        member(q, [1, 2, 3])
    }
}

// Check if specific element is member (forward mode)
@test
rel member_test_5() {
    member(2, [1, 2, 3])
}

// Check if element is NOT member (no solutions)
@test(expected = [])
rel member_test_6(result) {
    member(4, [1, 2, 3]),
    result == true
}

// Test member with nested lists
@test(expected = [1, [2, 3], 4])
rel member_test_7(q) {
    member(q, [1, [2, 3], 4])
}

// Test member with duplicates
@test(expected = [1, 1, 2, 3])
rel member_test_8(q) {
    member(q, [1, 1, 2, 3])
}

// Member once relation - like member, but succeeds only once per unique element
// This finds each distinct element only once, even if there are duplicates
pub rel member_once(x, l) {
    match l {
        [head | _] => head == x,
        [head | rest] => {
            head != x,
            member_once(x, rest)
        }
    }
}

// Check membership in empty list → no results
@test(expected = [])
rel member_once_test_1(q) {
    member_once(q, [])
}

// Find unique elements of [1, 2, 3] → [1, 2, 3] (same as member since no duplicates)
@test(expected = [1, 2, 3])
rel member_once_test_2(q) {
    member_once(q, [1, 2, 3])
}

// Check if specific element is member (forward mode)
@test
rel member_once_test_3() {
    member_once(2, [1, 2, 3])
}

// Check if element is NOT member (no solutions)
@test(expected = [])
rel member_once_test_4(result) {
    member_once(result, [1, 2, 3]),
    result == 4
}

// Test member_once with duplicates - should only return each unique element once
@test(expected = [1, 2, 3])
rel member_once_test_5(q) {
    member_once(q, [1, 1, 2, 3])
}

// Test member_once with more complex duplicates
@test(expected = [1, 0])
rel member_once_test_6(q) {
    member_once(q, [1, 0, 0, 0, 1])
}

// Test member_once with single element
@test(expected = [5])
rel member_once_test_7(q) {
    member_once(q, [5])
}

// Test member_once with all same elements
@test(expected = [1])
rel member_once_test_8(q) {
    member_once(q, [1, 1, 1, 1, 1])
}

// Test member_once with nested lists
@test(expected = [1, [2, 3], 4])
rel member_once_test_9(q) {
    member_once(q, [1, [2, 3], 4])
}

// Test member_once with nested list duplicates - should only return each unique element once
@test(expected = [[2, 3], 1])
rel member_once_test_10(q) {
    member_once(q, [[2, 3], 1, [2, 3], 1])
}

// Append relation - ls is l appended with s
pub rel append(l, s, ls) {
    match [l, s, ls] {
        [[], x, x] => true,
        [[x | l1], l2, [x | l3]] => append(l1, l2, l3)
    }
}

// Append two empty lists → []
@test(expected = [[]])
rel append_test_1(q) {
    append([], [], q)
}

// Append [1, 2] and [3, 4] → [1, 2, 3, 4]
@test(expected = [[1, 2, 3, 4]])
rel append_test_2(q) {
    append([1, 2], [3, 4], q)
}

// Append empty list to [1, 2] → [1, 2]
@test(expected = [[1, 2]])
rel append_test_3(q) {
    append([], [1, 2], q)
}

// Append [1, 2] to empty list → [1, 2]
@test(expected = [[1, 2]])
rel append_test_4(q) {
    append([1, 2], [], q)
}

// Try to append non-list (no solutions)
@test(expected = [])
rel append_test_5(q) {
    append(0, [1, 2], q)
}

// Append list to non-list creates improper list [1, 2 | 3]
@test(expected = [[1, 2 | 3]])
rel append_test_6(q) {
    append([1, 2], 3, q)
}

// Test append backward mode: find what lists make [1, 2, 3] when appended
@test(expected = [[[], [1, 2, 3]], [[1], [2, 3]], [[1, 2], [3]], [[1, 2, 3], []]])
rel append_test_7(q) {
    |l, s| {
        append(l, s, [1, 2, 3]),
        q == [l, s]
    }
}

// Test append with nested lists
@test(expected = [[[1, [2]], 3, 4]])
rel append_test_8(q) {
    append([[1, [2]]], [3, 4], q)
}

// Test append with longer lists
@test(expected = [[1, 2, 3, 4, 5, 6]])
rel append_test_9(q) {
    append([1, 2, 3], [4, 5, 6], q)
}


// Cons relation - out is rest with first prepended
pub rel cons(first, rest, out) {
    [first | rest] == out
}

// Cons 1 to empty list → [1]
@test(expected = [[1]])
rel cons_test_1(q) {
    cons(1, [], q)
}

// Cons 1 to [2, 3] → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel cons_test_2(q) {
    cons(1, [2, 3], q)
}

// Cons list [1] to [2, 3] → [[1], 2, 3]
@test(expected = [[[1], 2, 3]])
rel cons_test_3(q) {
    cons([1], [2, 3], q)
}

// Test cons backward mode: deconstruct [1, 2, 3] into first and rest
@test(expected = [[1, [2, 3]]])
rel cons_test_4(q) {
    |first, rest| {
        cons(first, rest, [1, 2, 3]),
        q == [first, rest]
    }
}

// Test cons with nested structures
@test(expected = [[[1, [2]], [3, 4]]])
rel cons_test_5(q) {
    cons([1, [2]], [[3, 4]], q)
}

// First element relation - first is the first element of list
pub rel first(list, first) {
    |rest| {
        cons(first, rest, list)
    }
}

// Extract first element from [1, 2, 3] → 1
@test(expected = [1])
rel first_test_1(q) {
    first([1, 2, 3], q)
}

// Extract first element from [[1, 2], 3, 4] → [1, 2]
@test(expected = [[1, 2]])
rel first_test_2(q) {
    first([[1, 2], 3, 4], q)
}

// Extract first element from empty list [] → no results
@test(expected = [])
rel first_test_3(q) {
    first([], q)
}

// Construct list with known first element → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel first_test_4(q) {
    first(q, 1),
    q == [1, 2, 3]
}

// Test first with deeply nested structure
@test(expected = [[[1, [2]], [3]]])
rel first_test_5(q) {
    first([[[1, [2]], [3]], 4], q)
}

// Rest relation - rest is list without its first element
// Implementation following rest.rs pattern using cons
pub rel rest(list, rest) {
    |first| {
        cons(first, rest, list)
    }
}

// Get rest of [1, 2, 3] → [2, 3]
@test(expected = [[2, 3]])
rel rest_test_1(q) {
    rest([1, 2, 3], q)
}

// Get rest of [[1, 2], 3, 4] → [3, 4]
@test(expected = [[3, 4]])
rel rest_test_2(q) {
    rest([[1, 2], 3, 4], q)
}

// Get rest of empty list [] → no results
@test(expected = [])
rel rest_test_3(q) {
    rest([], q)
}

// Get rest of single element [1] → []
@test(expected = [[]])
rel rest_test_4(q) {
    rest([1], q)
}

// Construct list with known rest → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rest_test_5(q) {
    rest(q, [2, 3]),
    q == [1, 2, 3]
}

// Test rest with deeply nested structure
@test(expected = [[4]])
rel rest_test_6(q) {
    rest([[[1, [2]], [3]], 4], q)
}

// Rember relation - out is ls with first occurrence of x removed
// Implementation following rember.rs pattern
pub rel rember(x, ls, out) {
    match [ls, out] {
        [[], []] => true,
        [[a | d], d] => a == x,
        [[y | ys], [y | zs]] => { 
            y != x,
            rember(x, ys, zs)
        }
    }
}

// Remove from empty list → []
@test(expected = [[]])
rel rember_test_1(q) {
    rember(1, [], q)
}

// Remove first element 1 from [1, 2, 3] → [2, 3]
@test(expected = [[2, 3]])
rel rember_test_2(q) {
    rember(1, [1, 2, 3], q)
}

// Remove middle element 2 from [1, 2, 3] → [1, 3]
@test(expected = [[1, 3]])
rel rember_test_3(q) {
    rember(2, [1, 2, 3], q)
}

// Remove last element 3 from [1, 2, 3] → [1, 2]
@test(expected = [[1, 2]])
rel rember_test_4(q) {
    rember(3, [1, 2, 3], q)
}

// Remove non-existent element 4 → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rember_test_5(q) {
    rember(4, [1, 2, 3], q)
}

// Remove first occurrence of 1 from [1, 1, 2, 3] → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rember_test_6(q) {
    rember(1, [1, 1, 2, 3], q)
}

// Find what was removed: rember(q, [1, 2, 3], [2, 3]) → 1
@test(expected = [1])
rel rember_test_7(q) {
    rember(q, [1, 2, 3], [2, 3])
}

// Test rember with nested lists
@test(expected = [[1, [3, 4]]])
rel rember_test_8(q) {
    rember([2], [1, [2], [3, 4]], q)
}

// Test rember with complex nested structure
@test(expected = [[[1, [2]], [4]]])
rel rember_test_9(q) {
    rember([3], [[1, [2]], [3], [4]], q)
}

// Permute relation - yl is a permutation of xl
// Implementation following permute.rs pattern
pub rel permute(xl, yl) {
    match [xl, yl] {
        [[], []] => true,
        [[x | xs], _] => {
            |ys| {
                permute(xs, ys),
                rember(x, yl, ys)
            }
        }
    }
}

// Empty lists are permutations → true
@test
rel permute_test_1() {
    permute([], [])
}

// Single element lists are permutations → true
@test
rel permute_test_2() {
    permute([1], [1])
}

// [1, 2] and [2, 1] are permutations → true
@test
rel permute_test_3() {
    permute([1, 2], [2, 1])
}

// [1, 2, 3] and [3, 1, 2] are permutations → true
@test
rel permute_test_4() {
    permute([1, 2, 3], [3, 1, 2]),
}

// [1, 2] and [1, 3] are not permutations → no results
@test(expected = [])
rel permute_test_5(result) {
    permute([1, 2], [1, 3]),
    result == true
}

// [1, 2, 3] and [4, 5, 6] are not permutations → no results
@test(expected = [])
rel permute_test_6(result) {
    permute([1, 2, 3], [4, 5, 6]),
    result == true
}

// [1, 2, 3] and [2, 3, 1] are permutations → true
@test
rel permute_test_7() {
    permute([1, 2, 3], [2, 3, 1])
}

// Test permute with duplicates
@test
rel permute_test_8() {
    permute([1, 1, 2], [2, 1, 1])
}

// Test permute with nested structures
@test
rel permute_test_9() {
    permute([[1, 2], [3]], [[3], [1, 2]])
}

// Test permute with longer list
@test
rel permute_test_10() {
    permute([1, 2, 3, 4], [4, 2, 1, 3])
} 

// Distinct relation - guarantees that all elements of l are distinct from each other
// Implementation following distinct.rs pattern
pub rel distinct(l) {
    match l {
        [] => true,
        [_] => true,
        [first, second | rest] => {
            first != second,
            distinct([first | rest]),
            distinct([second | rest])
        }
    }
}

// Empty list is distinct → true
@test
rel distinct_test_1() {
    distinct([])
}

// Single element list is distinct → true
@test
rel distinct_test_2() {
    distinct([1])
}

// Two different elements are distinct → true
@test
rel distinct_test_3() {
    distinct([1, 2])
}

// Two same elements are not distinct → no solutions
@test(expected = [])
rel distinct_test_4(result) {
    distinct([1, 1]),
    result == true
}

// Three different elements are distinct → true
@test
rel distinct_test_5() {
    distinct([1, 2, 3])
}

// Three elements with one duplicate are not distinct → no solutions
@test(expected = [])
rel distinct_test_6(result) {
    distinct([1, 2, 2]),
    result == true
}

// Four different elements are distinct → true
@test
rel distinct_test_7() {
    distinct([1, 2, 3, 4])
}

// Four elements with duplicates are not distinct → no solutions
@test(expected = [])
rel distinct_test_8(result) {
    distinct([1, 2, 3, 2]),
    result == true
}

// Test distinct with nested lists
@test
rel distinct_test_9() {
    distinct([[1, 2], [3, 4], [5]])
}

// Test distinct with nested lists containing duplicates → no solutions
@test(expected = [])
rel distinct_test_10(result) {
    distinct([[1, 2], [3, 4], [1, 2]]),
    result == true
}

// =============================================================================

// Length relation - determines the length of a list
// This wraps the builtin __builtin_length predicate for efficiency
// while providing a clean library interface
pub rel length(list, n) {
    __builtin_length(list, n)
}

// Test length with empty list
@test(expected = [0])
rel length_test_1(n) {
    length([], n)
}

// Test length with single element
@test(expected = [1])
rel length_test_2(n) {
    length([1], n)
}

// Test length with three elements
@test(expected = [3])
rel length_test_3(n) {
    length([1, 2, 3], n)
}

// Test length check (forward mode)
@test
rel length_test_4() {
    length([1, 2, 3], 3)
} 

// =============================================================================
// STRUCTURAL PREDICATES
// =============================================================================

// Check if x is a pair (has structure [a | d])
pub rel is_pair(x) {
    |a, d| { x == [a | d] }
}

// Flatten nested structure
pub rel flatten(tree, flat) {
    any {
        // Base case: tree is not a pair (i.e., atom)
        all {
            flat == [tree],
            not_pair(tree)
        },
        
        // Recursive case: tree is a pair
        |a, d, fa, fd| {
            tree == [a | d],
            flatten(a, fa),
            flatten(d, fd),
            append(fa, fd, flat)
        }
    }
}

// Helper for flatten - check if value is not a pair
pub rel not_pair(tree) {
    any {
        all { is_pair(tree), false },  // if is_pair(tree) succeeds, then fail
        true  // else succeed (reached only if is_pair(tree) fails)
    }
}

// Simple flatten for list of lists - concatenates all sublists
pub rel flatten_lists(nested_list, flat_list) {
    match nested_list {
        [] => flat_list == [],
        [head | tail] => |flat_tail| {
            flatten_lists(tail, flat_tail),
            append(head, flat_tail, flat_list)
        }
    }
}

// =============================================================================
// LIST ACCESS AND VERIFICATION
// =============================================================================

// Get the nth element (0-indexed) from a list
pub rel nth(n, list, element) {
    any {
        // Base case: index is 0, get head
        |head, tail| {
            n == 0,
            list == [head | tail],
            element == head
        },
        
        // Recursive case: index > 0
        |n1, head, tail| {
            list == [head | tail],
            constraint(domain="clpz") {
                n > 0,
                n1 == n - 1
            },
            nth(n1, tail, element)
        }
    }
}

// =============================================================================
// MATRIX OPERATIONS (LISTS OF LISTS)
// =============================================================================

// Transpose a matrix (list of lists) with structural guards to prevent infinite recursion
// rows: list of lists to transpose  
// cols: transposed matrix  
pub rel transpose(rows, cols) {
    any {
        // Base case: empty matrix
        all {
            rows == [],
            cols == []
        },
        
        // Case: matrix with all empty rows
        |first_row, rest_rows| {
            all {
                rows == [first_row | rest_rows],
                first_row == [],
                all_empty(rest_rows),
                cols == []
            }
        },
        
        // Case: matrix with at least one non-empty row
        // STRUCTURAL GUARD: This only applies when first row is non-empty
        |first_row, rest_rows, heads, tails, rest_cols| {
            all {
                rows == [first_row | rest_rows],
                // GUARD: first_row must be non-empty to proceed
                first_row != [],
                unzip_matrix(rows, heads, tails),
                // STRUCTURAL DECREASE: tails is structurally smaller than rows
                transpose(tails, rest_cols),
                cols == [heads | rest_cols]
            }
        }
    }
}

// Check if all rows are empty
pub rel all_empty(rows) {
    any {
        rows == [],
        |row, rest| {
            all {
                rows == [row | rest],
                row == [],
                all_empty(rest)
            }
        }
    }
}

// Unzip matrix into heads (first column) and tails (remaining matrix)
pub rel unzip_matrix(matrix, heads, tails) {
    any {
        // Base case: empty matrix
        all {
            matrix == [],
            heads == [],
            tails == []
        },
        
        // Extract head and tail from first row, recurse on remaining rows
        |row, rows, h, t, hs, ts| {
            all {
                matrix == [row | rows],
                row == [h | t],
                heads == [h | hs],
                tails == [t | ts],
                unzip_matrix(rows, hs, ts)
            }
        }
    }
}