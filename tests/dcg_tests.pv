// Comprehensive tests for DCG (Definite Clause Grammar) functionality
// Tests core DCG compilation and usage patterns

use std::list::{member, append};
use std::dcg::{any_element, terminal, eos};

// =============================================================================
// DCG Test Utilities - Define DCG rules for testing
// =============================================================================

/// DCG that peeks at next element without consuming it
dcg peek_element(element) {
    match Input {
        [element | _] => Output == Input
    }
}

/// DCG that matches end of input
dcg end_of_input() {
    eos()
}

/// DCG that matches a sequence of terminals
dcg sequence(items) {
    match items {
        [] => Output == Input,
        [first | rest] => all {
            terminal(first),
            sequence(rest)
        }
    }
}

/// DCG for optional terminal (succeeds whether element is present or not)
dcg optional_terminal(element) {
    any {
        terminal(element),
        Output == Input  // No consumption if not found
    }
}

/// DCG for digit characters
dcg digit_char(d) {
    any {
        all { terminal("0"), d == 0 },
        all { terminal("1"), d == 1 },
        all { terminal("2"), d == 2 },
        all { terminal("3"), d == 3 },
        all { terminal("4"), d == 4 },
        all { terminal("5"), d == 5 },
        all { terminal("6"), d == 6 },
        all { terminal("7"), d == 7 },
        all { terminal("8"), d == 8 },
        all { terminal("9"), d == 9 }
    }
}

// =============================================================================
// Basic Terminal Tests
// =============================================================================

@test
rel test_terminal_match() {
    terminal("hello", ["hello", "world"], ["world"])
}

@test
rel test_terminal_different_element() {
    terminal("goodbye", ["goodbye", "world"], ["world"])
}

@test
rel test_any_element_consumption() {
    any_element("first", ["first", "second"], ["second"])
}

@test
rel test_any_element_variable_binding() {
    |element| {
        any_element(element, ["x", "y", "z"], ["y", "z"]),
        assert_eq(element, "x")
    }
}

@test
rel test_peek_no_consumption() {
    peek_element("hello", ["hello", "world"], ["hello", "world"])
}

// =============================================================================
// Sequence Tests
// =============================================================================

@test
rel test_sequence_empty() {
    sequence([], ["any", "input"], ["any", "input"])
}

@test
rel test_sequence_single() {
    sequence(["hello"], ["hello", "world"], ["world"])
}

@test
rel test_sequence_multiple() {
    sequence(["hello", "world"], ["hello", "world", "!"], ["!"])
}

@test
rel test_sequence_exact_match() {
    sequence(["a", "b", "c"], ["a", "b", "c"], [])
}

// =============================================================================
// Control Flow Tests
// =============================================================================

@test
rel test_end_of_input_empty() {
    end_of_input([], [])
}

@test
rel test_optional_terminal_present() {
    optional_terminal("hello", ["hello", "world"], ["world"])
}

@test
rel test_optional_terminal_absent() {
    optional_terminal("goodbye", ["hello", "world"], ["hello", "world"])
}

// =============================================================================
// Character Class Tests  
// =============================================================================

@test
rel test_digit_char_zero() {
    digit_char(0, ["0", "1", "2"], ["1", "2"])
}

@test
rel test_digit_char_nine() {
    digit_char(9, ["9", "8", "7"], ["8", "7"])
}

@test
rel test_digit_char_middle() {
    digit_char(5, ["5", "abc"], ["abc"])
}

// =============================================================================
// Complex Integration Tests
// =============================================================================

/// Test a simple expression parser using DCG utilities
dcg number_token(n) {
    digit_char(n)
}

dcg plus_token() {
    terminal("+")
}

dcg simple_expression(left, right) {
    number_token(left),
    plus_token(),
    number_token(right)
}

@test
rel test_simple_expression_parsing() {
    simple_expression(3, 5, ["3", "+", "5"], [])
}

@test
rel test_simple_expression_with_remainder() {
    simple_expression(1, 2, ["1", "+", "2", "extra"], ["extra"])
}

/// Test sentence structure parsing
dcg article() {
    any {
        terminal("the"),
        terminal("a"),
        terminal("an")
    }
}

dcg noun() {
    any {
        terminal("cat"),
        terminal("dog"),
        terminal("bird")
    }
}

dcg verb() {
    any {
        terminal("runs"),
        terminal("flies"),
        terminal("sleeps")
    }
}

dcg simple_sentence() {
    article(),
    noun(),
    verb()
}

@test
rel test_simple_sentence_parsing() {
    simple_sentence(["the", "cat", "runs"], [])
}

@test
rel test_simple_sentence_with_remainder() {
    simple_sentence(["a", "dog", "sleeps", "quietly"], ["quietly"])
}

@test
rel test_simple_sentence_different_combinations() {
    all {
        simple_sentence(["the", "bird", "flies"], []),
        simple_sentence(["a", "cat", "runs"], []),
        simple_sentence(["an", "dog", "sleeps"], [])
    }
}

// =============================================================================
// Edge Case Tests
// =============================================================================

@test
rel test_empty_input_handling() {
    all {
        end_of_input([], []),
        optional_terminal("x", [], []),
        sequence([], [], [])
    }
}

@test
rel test_single_element_lists() {
    all {
        terminal("x", ["x"], []),
        any_element("y", ["y"], []),
        sequence(["z"], ["z"], [])
    }
}

// Test DCG with pattern matching and guards
dcg conditional_terminal(element, should_match) {
    match Input {
        [element | rest] if should_match == true => Output == rest
    }
}

@test 
rel test_conditional_terminal_with_guard() {
    conditional_terminal("hello", true, ["hello", "world"], ["world"])
}

// Test backtracking behavior
dcg alternative_terminals(matched) {
    any {
        all { terminal("first"), matched == "first" },
        all { terminal("second"), matched == "second" },
        all { terminal("third"), matched == "third" }
    }
}

@test
rel test_backtracking_alternatives() {
    all {
        alternative_terminals("first", ["first", "rest"], ["rest"]),
        alternative_terminals("second", ["second", "rest"], ["rest"]),
        alternative_terminals("third", ["third", "rest"], ["rest"])
    }
}

// =============================================================================
// DCG Composition Tests
// =============================================================================

/// Test composing DCGs in complex ways
dcg word_and_punct(word, punct) {
    terminal(word),
    terminal(punct)
}

@test
rel test_dcg_composition() {
    word_and_punct("hello", "!", ["hello", "!", "world"], ["world"])
}

/// Test nested DCG calls
dcg nested_sequence() {
    simple_expression(_, _),  // Parse any expression
    terminal("end")
}

@test
rel test_nested_dcg_calls() {
    nested_sequence(["7", "+", "8", "end"], [])
}

// =============================================================================
// Performance and Stress Tests
// =============================================================================

@test
rel test_long_sequence() {
    |long_list| {
        long_list == ["a", "b", "c", "d", "e", "f", "g", "h"],
        sequence(long_list, long_list, [])
    }
}

/// Test deeply nested alternatives
dcg nested_choice(result) {
    any {
        all { terminal("a"), result == "a" },
        any {
            all { terminal("b"), result == "b" },
            any {
                all { terminal("c"), result == "c" },
                all { terminal("d"), result == "d" }
            }
        }
    }
}

@test
rel test_nested_choice_deep() {
    nested_choice("d", ["d"], [])
}

@test
rel test_nested_choice_shallow() {
    nested_choice("a", ["a"], [])
}

// =============================================================================
// DCG Fix Verification Tests - Tests for the specific issues that were fixed
// =============================================================================

/// Test that Input/Output variables are properly in scope for pattern matching
/// This was the core issue - DCG Input/Output parameters weren't being added to scope
@test
rel test_input_output_variables_in_scope() {
    // This DCG directly references Input and Output variables in pattern matching
    |element| {
        dcg_with_direct_input_output_reference(element, ["test"], []),
        element == "test"
    }
}

dcg dcg_with_direct_input_output_reference(element) {
    match Input {
        [element | rest] => Output == rest
    }
}

/// Test DCG calling another DCG (difference list threading)
/// Verifies that DCG predicates get Input/Output args when called from other DCGs
@test
rel test_dcg_calling_dcg() {
    |result| {
        dcg_caller(result, ["first", "second"], []),
        result == ["first", "second"]
    }
}

dcg dcg_caller(result) {
    |first, second| {
        any_element(first),
        any_element(second),
        result == [first, second]
    }
}

/// Test DCG calling non-DCG predicate (guard behavior)
/// Verifies that non-DCG predicates don't get Input/Output args when called from DCGs
@test
rel test_dcg_calling_non_dcg() {
    |result| {
        dcg_with_guard(result, ["valid"], []),
        result == "valid"
    }
}

dcg dcg_with_guard(result) {
    |element| {
        any_element(element),
        is_valid_element(element),  // Non-DCG predicate as guard
        result == element
    }
}

rel is_valid_element(element) {
    element == "valid"
}

/// Test nested DCG conjunctions with mixed DCG/non-DCG goals
/// Verifies proper threading through complex nested structures
@test
rel test_nested_dcg_conjunctions() {
    nested_dcg_conjunction(["a", "b"], ["a", "b"], [])
}

dcg nested_dcg_conjunction(expected) {
    |first| {
        any_element(first),
        all {
            |second| {
                any_element(second),
                first == "a",  // Non-DCG guard
                second == "b", // Non-DCG guard
                expected == [first, second]
            }
        }
    }
}

/// Test nested DCG disjunctions with proper threading
/// Verifies that each branch of disjunction gets same Input/Output
@test
rel test_nested_dcg_disjunctions() {
    |result1, result2| {
        all {
            nested_dcg_disjunction(result1, ["x"], []),
            result1 == "x",
            nested_dcg_disjunction(result2, ["y"], []),
            result2 == "y"
        }
    }
}

dcg nested_dcg_disjunction(result) {
    any {
        all {
            terminal("x"),
            result == "x"
        },
        all {
            terminal("y"), 
            result == "y"
        }
    }
}

/// Test recursive DCG that was failing before the fix
/// This combines all the problematic patterns: recursion, std library DCGs, mixed goals
@test
rel test_recursive_dcg_with_std_library() {
    |result| {
        recursive_parser(result, ["1", "2"], ["2"]),
        result == ["1"]
    }
}

dcg recursive_parser(digits) {
    |first_digit| {
        any_element(first_digit),
        first_digit == "1", // Guard to ensure it's digit 1
        any {
            all {
                |rest_digits| {
                    recursive_parser(rest_digits),
                    digits == [first_digit | rest_digits]
                }
            },
            digits == [first_digit]
        }
    }
}

/// Test that std library DCG predicates work correctly from within other DCGs
@test  
rel test_std_dcg_from_dcg() {
    // Test direct call to std::dcg::any_element first
    |elem| {
        any_element(elem, ["hello"], []),
        elem == "hello"
    }
}

/// Test complex DCG with multiple std library calls and guards
@test
rel test_complex_dcg_with_std_and_guards() {
    |result| {
        complex_dcg_parser(result, ["a", "b", "c"], []),
        result == ["a", "b", "c"]
    }
}

dcg complex_dcg_parser(result) {
    |first, second, third| {
        any_element(first),
        first == "a",  // Non-DCG guard
        any_element(second), 
        second == "b", // Non-DCG guard
        any_element(third),
        third == "c",  // Non-DCG guard
        result == [first, second, third]
    }
}

/// Test Input/Output variable references in arm bodies work correctly
@test
rel test_pattern_match_arm_input_output() {
    pattern_with_input_output_refs(["test"], [])
}

dcg pattern_with_input_output_refs() {
    match Input {
        ["test" | rest] => all {
            Output == rest,
            rest == []  // This references the pattern variable
        }
    }
}