// tests/custom_import_tests.pv
// Tests for user-defined module imports

// Test simple module import
use tests::test_module::*;

// Test selective imports with specific symbols
use tests::test_module::{test_relation, helper_relation};

// Test imports with aliases
use tests::test_module::{test_relation as tr, helper_relation as hr};

// --- Test Simple Module Import ---

@test(expected = ["test_value"])
rel test_simple_import(result) {
    test_relation(result)
}

@test(expected = ["helper"])
rel test_simple_import_helper(x) {
    helper_relation(x, "result")
}

// --- Test Selective Imports ---

@test(expected = ["test_value"])
rel test_selective_import(result) {
    test_relation(result)
}

@test(expected = ["helper"])
rel test_selective_import_helper(x) {
    helper_relation(x, "result")
}

// --- Test Import Aliases ---

@test(expected = ["test_value"])
rel test_alias_import(result) {
    tr(result)
}

@test(expected = ["helper"])
rel test_alias_import_helper(x) {
    hr(x, "result")
}

// --- Test Error Cases ---

// This should fail at compile time - trying to import private symbol
// use tests::test_module::{private_relation};

