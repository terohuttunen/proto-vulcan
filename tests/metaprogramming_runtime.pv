// Comprehensive runtime tests for metaprogramming features
// Tests the template expansion engine

// Test basic meta let statement execution
@test(expected = [5])
rel test_meta_let_basic(result) {
    let x: int = 5;
    let message: string = "hello";
    let flag: bool = true;
    result == x
}

// Test meta if statement with true condition
@test
rel test_meta_if_true(result) {
    let condition: bool = true;
    if condition {
        result == "then_branch"
    } else {
        result == "else_branch"
    }
}

// Test meta if statement with false condition
@test
rel test_meta_if_false(result) {
    let condition: bool = false;
    if condition {
        result == "then_branch"
    } else {
        result == "else_branch"
    }
}

// Test meta for loop with simple range
@test(expected = [1, 2, 3])
rel test_meta_for_simple(result) {
    for i: int in 1..4 {
        result == i
    }
}

// Test interpolation with meta variables
@test(expected = [42])
rel test_interpolation_basic(result) {
    let value: int = 42;
    let name: string = "test";
    result == {value}
}

// Test complex nested metaprogramming
@test
rel test_nested_metaprogramming(result) {
    let count: int = 3;
    let use_loop: bool = true;
    if use_loop {
        for i: int in 1..count {
            let item_name: string = "item";
            result == {item_name}
        }
    } else {
        result == "no_loop"
    }
}

// Test arithmetic expressions in meta context
@test(expected = [8])
rel test_meta_arithmetic(result) {
    let a: int = 5;
    let b: int = 3;
    let sum: int = a + b;
    let product: int = a * b;
    if sum > 7 && product < 20 {
        result == sum
    } else {
        result == 0
    }
}

// Test meta for loop with computed range
@test(expected = [2, 3, 4])
rel test_meta_for_computed_range(result) {
    let start: int = 2;
    let end: int = start + 3;
    for i: int in start..end {
        result == i
    }
}

// Test string operations in metaprogramming 
@test(expected = ["hello world"])
rel test_meta_string_ops(result) {
    let prefix: string = "hello";
    let suffix: string = "world"; 
    let space: string = " ";
    let temp: string = prefix + space;
    let combined: string = temp + suffix;
    if combined == "hello world" {
        result == combined
    } else {
        result == "string_failure"
    }
}

// Test meta if with complex boolean expressions
@test(expected = [2])
rel test_meta_complex_boolean(result) {
    let x: int = 10;
    let y: int = 5;
    let flag: bool = true;
    let quotient: int = x / y;
    if (x > y) && flag && (quotient == 2) {
        result == quotient
    } else {
        result == 0
    }
}

// Test interpolation in different contexts
@test(expected = [123, "value", true])
rel test_interpolation_contexts(result) {
    let number: int = 123;
    let text: string = "value";
    let truth: bool = true;
    
    // Interpolation in equality using any for disjunction
    any {
        result == {number},
        result == {text},
        result == {truth}
    }
}

// Test meta for loop generating multiple goals
@test
rel test_meta_for_multiple_goals(result) {
    for i: int in 1..3 {
        for j: int in 1..2 {
            result == "nested_loop_item"
        }
    }
}

// Test meta programming with regular logic programming
@test
rel test_mixed_meta_and_regular(result) {
    let base: int = 10;
    |x| {
        x == {base},
        regular_helper(x, result)
    }
}

rel regular_helper(input, output) {
    input == 10,
    output == "mixed_success"
}

// Test edge cases
@test
rel test_empty_for_loop(result) {
    // This should produce no goals
    for i: int in 5..5 {
        result == "should_not_appear"
    }
    // This should always succeed since no constraints are added
    result == "empty_loop_default"
}

@test
rel test_nested_if_statements(result) {
    let outer: bool = true;
    let inner: bool = false;
    if outer {
        if inner {
            result == "both_true"
        } else {
            result == "outer_true_inner_false"
        }
    } else {
        result == "outer_false"
    }
}

// Test enum variant expansion in metaprogramming
enum Color { Red, Green, Blue }
enum Container { Empty, Single(value), Pair(first, second) }
enum Person { Anonymous, Named { name: String, age: Number } }

// Test enum variants with interpolated values
@test(expected = [Container::Single(42)])
rel test_enum_value_expansion(result) {
    let value: int = 42;
    result == Container::Single({value})
}

// Test enum variants with multiple interpolated values
@test(expected = [Container::Pair(10, 20)])
rel test_enum_multi_value_expansion(result) {
    let first: int = 10;
    let second: int = 20;
    result == Container::Pair({first}, {second})
}

// Test named enum variant with interpolated fields
@test(expected = [Person::Named { name: "Alice", age: 30 }])
rel test_enum_named_field_expansion(result) {
    let person_name: string = "Alice";
    let person_age: int = 30;
    result == Person::Named { name: {person_name}, age: {person_age} }
}

// Test simple enum expansion without loops (metaprogramming context has limitations)
@test(expected = [Container::Single(10)])
rel test_enum_expansion_computed(result) {
    let value: int = 5;
    let multiplier: int = 2;
    let computed: int = value * multiplier;
    result == Container::Single({computed})
}

// Test complex enum expansion with nested expressions
@test(expected = [Container::Pair(5, 15)])
rel test_enum_complex_expansion(result) {
    let base: int = 5;
    let multiplier: int = 3;
    let computed: int = base * multiplier;
    result == Container::Pair({base}, {computed})
}

// Test struct expansion in metaprogramming
struct Point(Number, Number);
struct Rectangle { width: Number, height: Number }
struct Box { item: String, quantity: Number }

// Test tuple struct with interpolated values
@test(expected = [Point(10, 20)])
rel test_tuple_struct_expansion(result) {
    let x: int = 10;
    let y: int = 20;
    result == Point({x}, {y})
}

// Test tuple struct with computed values
@test(expected = [Point(5, 10)])
rel test_tuple_struct_computed_expansion(result) {
    let base: int = 5;
    let multiplier: int = 2;
    let y_coord: int = base * multiplier;
    result == Point({base}, {y_coord})
}

// Test named struct with interpolated fields
@test(expected = [Rectangle { width: 15, height: 25 }])
rel test_named_struct_expansion(result) {
    let w: int = 15;
    let h: int = 25;
    result == Rectangle { width: {w}, height: {h} }
}

// Test named struct with computed fields
@test(expected = [Rectangle { width: 12, height: 18 }])
rel test_named_struct_computed_expansion(result) {
    let base_width: int = 6;
    let width_multiplier: int = 2;
    let height_factor: int = 3;
    let final_width: int = base_width * width_multiplier;
    let final_height: int = base_width * height_factor;
    result == Rectangle { width: {final_width}, height: {final_height} }
}

// Test mixed field types in named struct
@test(expected = [Box { item: "widget", quantity: 42 }])
rel test_mixed_field_struct_expansion(result) {
    let item_name: string = "widget";
    let count: int = 42;
    result == Box { item: {item_name}, quantity: {count} }
}

// Test struct field order independence with interpolation
@test(expected = [Rectangle { width: 8, height: 12 }])
rel test_struct_field_order_expansion(result) {
    let w: int = 8;
    let h: int = 12;
    result == Rectangle { height: {h}, width: {w} }
}

// Test nested struct expansion
struct Container3D { position: Point, dimensions: Rectangle }

@test(expected = [Container3D { position: Point(1, 2), dimensions: Rectangle { width: 10, height: 20 } }])
rel test_nested_struct_expansion(result) {
    let x: int = 1;
    let y: int = 2;
    let w: int = 10;
    let h: int = 20;
    result == Container3D { 
        position: Point({x}, {y}), 
        dimensions: Rectangle { width: {w}, height: {h} } 
    }
}

// Test struct expansion with arithmetic expressions
@test(expected = [Point(15, 35)])
rel test_struct_arithmetic_expansion(result) {
    let a: int = 3;
    let b: int = 5;
    let c: int = 7;
    let x_val: int = a * b;
    let y_val: int = b * c;
    result == Point({x_val}, {y_val})
} 