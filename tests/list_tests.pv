// List Operations Test Suite
// Tests for structural and utility predicates in std::list

use std::list::*;

// =============================================================================
// ARITHMETIC PREDICATES (CONSTRAINT-BASED) - FOR TESTING ONLY
// =============================================================================

// Check if a number is positive (greater than 0)
rel positive(n) {
    constraint(domain="clpz") {
        n > 0
    }
}

// =============================================================================
// MATRIX OPERATION TESTS
// =============================================================================

// Test transpose with simple 2x2 matrix
@test(expected = [[[1, 3], [2, 4]]])
rel test_transpose_2x2(result) {
    transpose([[1, 2], [3, 4]], result)
}

// Test transpose with 2x3 matrix  
@test(expected = [[[1, 4], [2, 5], [3, 6]]])
rel test_transpose_2x3(result) {
    transpose([[1, 2, 3], [4, 5, 6]], result)
}

// Test transpose with empty matrix
@test(expected = [1])
rel test_transpose_empty(result) {
    transpose([], []),
    result == 1
}

// Test flatten_lists with nested lists
@test(expected = [[1, 2, 3, 4]])
rel test_flatten_simple(result) {
    flatten_lists([[1, 2], [3, 4]], result)
}

// Test flatten_lists with empty lists
@test(expected = [1])
rel test_flatten_empty(result) {
    flatten_lists([], []),
    result == 1
}

// =============================================================================
// LIST ACCESS TESTS
// =============================================================================

// Test nth with simple access
@test(expected = [2])
rel test_nth_simple(result) {
    nth(1, [1, 2, 3], result)
}

// Test nth with first element
@test(expected = [1])
rel test_nth_first(result) {
    nth(0, [1, 2, 3], result)
}

// Test nth with last element
@test(expected = [3])
rel test_nth_last(result) {
    nth(2, [1, 2, 3], result)
}

// =============================================================================
// BASIC LIST UTILITY TESTS
// =============================================================================

// Test length utility
@test(expected = [1])
rel test_length_basic(result) {
    length([1, 2, 3], 3),
    result == 1
}

// Test length with empty list
@test(expected = [1])
rel test_length_empty(result) {
    length([], 0),
    result == 1
}

// Test member_once with duplicates - should return unique elements only once
@test(expected = [1, 2, 3])
rel test_member_once_duplicates(result) {
    member_once(result, [1, 1, 2, 2, 3, 3])
}

// =============================================================================
// MATRIX PROCESSING INTEGRATION TEST
// =============================================================================

// Test matrix processing pipeline: transpose -> flatten -> check properties
@test(expected = [1])
rel test_matrix_pipeline(result) {
    |matrix, transposed, flattened| {
        matrix == [[1, 2], [3, 4]],
        transpose(matrix, transposed),
        flatten_lists(transposed, flattened),
        // Basic structural check - all elements are positive
        |elem1, elem2, elem3, elem4| {
            nth(0, flattened, elem1),
            nth(1, flattened, elem2), 
            nth(2, flattened, elem3),
            nth(3, flattened, elem4),
            positive(elem1),
            positive(elem2),
            positive(elem3), 
            positive(elem4),
            result == 1
        }
    }
}

// =============================================================================
// STRUCTURAL CONSTRAINT TESTS
// =============================================================================

// Test 4x4 structure validation using basic list operations
@test(expected = [1])
rel test_4x4_structure(result) {
    |board| {
        board == [
            [1, 2, 3, 4],
            [3, 4, 1, 2], 
            [2, 1, 4, 3],
            [4, 3, 2, 1]
        ],
        
        // Test board structure
        length(board, 4),
        
        // Test each row has length 4
        |row1, row2, row3, row4| {
            nth(0, board, row1),
            nth(1, board, row2),
            nth(2, board, row3),
            nth(3, board, row4),
            length(row1, 4),
            length(row2, 4),
            length(row3, 4),
            length(row4, 4),
            result == 1
        }
    }
}

// Helper for testing length constraints
rel length_4(list) {
    length(list, 4)
}

// =============================================================================
// BASIC LIST OPERATION TESTS (moved from std/list.pv)
// =============================================================================

// Check membership in empty list → no results
@test(expected = [])
rel member_test_1(q) {
    member(q, [])
}

// Find all members of [1, 2, 3] → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_2(q) {
    member(q, [1, 2, 3])
}

// Test member with any block (same as member_test_2) → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_3(q) {
    any {
        member(q, [1, 2, 3])
    }
}

// Test member with all block (same as member_test_2) → [1, 2, 3]
@test(expected = [1, 2, 3])
rel member_test_4(q) {
    all {
        member(q, [1, 2, 3])
    }
}

// Check if specific element is member (forward mode)
@test
rel member_test_5() {
    member(2, [1, 2, 3])
}

// Check if element is NOT member (no solutions)
@test(expected = [])
rel member_test_6(result) {
    member(4, [1, 2, 3]),
    result == true
}

// Test member with nested lists
@test(expected = [1, [2, 3], 4])
rel member_test_7(q) {
    member(q, [1, [2, 3], 4])
}

// Test member with duplicates
@test(expected = [1, 1, 2, 3])
rel member_test_8(q) {
    member(q, [1, 1, 2, 3])
}

// Check membership in empty list → no results
@test(expected = [])
rel member_once_test_1(q) {
    member_once(q, [])
}

// Find unique elements of [1, 2, 3] → [1, 2, 3] (same as member since no duplicates)
@test(expected = [1, 2, 3])
rel member_once_test_2(q) {
    member_once(q, [1, 2, 3])
}

// Check if specific element is member (forward mode)
@test
rel member_once_test_3() {
    member_once(2, [1, 2, 3])
}

// Check if element is NOT member (no solutions)
@test(expected = [])
rel member_once_test_4(result) {
    member_once(result, [1, 2, 3]),
    result == 4
}

// Test member_once with duplicates - should only return each unique element once
@test(expected = [1, 2, 3])
rel member_once_test_5(q) {
    member_once(q, [1, 1, 2, 3])
}

// Test member_once with more complex duplicates
@test(expected = [1, 0])
rel member_once_test_6(q) {
    member_once(q, [1, 0, 0, 0, 1])
}

// Test member_once with single element
@test(expected = [5])
rel member_once_test_7(q) {
    member_once(q, [5])
}

// Test member_once with all same elements
@test(expected = [1])
rel member_once_test_8(q) {
    member_once(q, [1, 1, 1, 1, 1])
}

// Test member_once with nested lists
@test(expected = [1, [2, 3], 4])
rel member_once_test_9(q) {
    member_once(q, [1, [2, 3], 4])
}

// Test member_once with nested list duplicates - should only return each unique element once
@test(expected = [[2, 3], 1])
rel member_once_test_10(q) {
    member_once(q, [[2, 3], 1, [2, 3], 1])
}

// Append two empty lists → []
@test(expected = [[]])
rel append_test_1(q) {
    append([], [], q)
}

// Append [1, 2] and [3, 4] → [1, 2, 3, 4]
@test(expected = [[1, 2, 3, 4]])
rel append_test_2(q) {
    append([1, 2], [3, 4], q)
}

// Append empty list to [1, 2] → [1, 2]
@test(expected = [[1, 2]])
rel append_test_3(q) {
    append([], [1, 2], q)
}

// Append [1, 2] to empty list → [1, 2]
@test(expected = [[1, 2]])
rel append_test_4(q) {
    append([1, 2], [], q)
}

// Try to append non-list (no solutions)
@test(expected = [])
rel append_test_5(q) {
    append(0, [1, 2], q)
}

// Append list to non-list creates improper list [1, 2 | 3]
@test(expected = [[1, 2 | 3]])
rel append_test_6(q) {
    append([1, 2], 3, q)
}

// Test append backward mode: find what lists make [1, 2, 3] when appended
@test(expected = [[[], [1, 2, 3]], [[1], [2, 3]], [[1, 2], [3]], [[1, 2, 3], []]])
rel append_test_7(q) {
    |l, s| {
        append(l, s, [1, 2, 3]),
        q == [l, s]
    }
}

// Test append with nested lists
@test(expected = [[[1, [2]], 3, 4]])
rel append_test_8(q) {
    append([[1, [2]]], [3, 4], q)
}

// Test append with longer lists
@test(expected = [[1, 2, 3, 4, 5, 6]])
rel append_test_9(q) {
    append([1, 2, 3], [4, 5, 6], q)
}

// Cons 1 to empty list → [1]
@test(expected = [[1]])
rel cons_test_1(q) {
    cons(1, [], q)
}

// Cons 1 to [2, 3] → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel cons_test_2(q) {
    cons(1, [2, 3], q)
}

// Cons list [1] to [2, 3] → [[1], 2, 3]
@test(expected = [[[1], 2, 3]])
rel cons_test_3(q) {
    cons([1], [2, 3], q)
}

// Test cons backward mode: deconstruct [1, 2, 3] into first and rest
@test(expected = [[1, [2, 3]]])
rel cons_test_4(q) {
    |first, rest| {
        cons(first, rest, [1, 2, 3]),
        q == [first, rest]
    }
}

// Test cons with nested structures
@test(expected = [[[1, [2]], [3, 4]]])
rel cons_test_5(q) {
    cons([1, [2]], [[3, 4]], q)
}

// Extract first element from [1, 2, 3] → 1
@test(expected = [1])
rel first_test_1(q) {
    first([1, 2, 3], q)
}

// Extract first element from [[1, 2], 3, 4] → [1, 2]
@test(expected = [[1, 2]])
rel first_test_2(q) {
    first([[1, 2], 3, 4], q)
}

// Extract first element from empty list [] → no results
@test(expected = [])
rel first_test_3(q) {
    first([], q)
}

// Construct list with known first element → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel first_test_4(q) {
    first(q, 1),
    q == [1, 2, 3]
}

// Test first with deeply nested structure
@test(expected = [[[1, [2]], [3]]])
rel first_test_5(q) {
    first([[[1, [2]], [3]], 4], q)
}

// Get rest of [1, 2, 3] → [2, 3]
@test(expected = [[2, 3]])
rel rest_test_1(q) {
    rest([1, 2, 3], q)
}

// Get rest of [[1, 2], 3, 4] → [3, 4]
@test(expected = [[3, 4]])
rel rest_test_2(q) {
    rest([[1, 2], 3, 4], q)
}

// Get rest of empty list [] → no results
@test(expected = [])
rel rest_test_3(q) {
    rest([], q)
}

// Get rest of single element [1] → []
@test(expected = [[]])
rel rest_test_4(q) {
    rest([1], q)
}

// Construct list with known rest → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rest_test_5(q) {
    rest(q, [2, 3]),
    q == [1, 2, 3]
}

// Test rest with deeply nested structure
@test(expected = [[4]])
rel rest_test_6(q) {
    rest([[[1, [2]], [3]], 4], q)
}

// Remove from empty list → []
@test(expected = [[]])
rel rember_test_1(q) {
    rember(1, [], q)
}

// Remove first element 1 from [1, 2, 3] → [2, 3]
@test(expected = [[2, 3]])
rel rember_test_2(q) {
    rember(1, [1, 2, 3], q)
}

// Remove middle element 2 from [1, 2, 3] → [1, 3]
@test(expected = [[1, 3]])
rel rember_test_3(q) {
    rember(2, [1, 2, 3], q)
}

// Remove last element 3 from [1, 2, 3] → [1, 2]
@test(expected = [[1, 2]])
rel rember_test_4(q) {
    rember(3, [1, 2, 3], q)
}

// Remove non-existent element 4 → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rember_test_5(q) {
    rember(4, [1, 2, 3], q)
}

// Remove first occurrence of 1 from [1, 1, 2, 3] → [1, 2, 3]
@test(expected = [[1, 2, 3]])
rel rember_test_6(q) {
    rember(1, [1, 1, 2, 3], q)
}

// Find what was removed: rember(q, [1, 2, 3], [2, 3]) → 1
@test(expected = [1])
rel rember_test_7(q) {
    rember(q, [1, 2, 3], [2, 3])
}

// Test rember with nested lists
@test(expected = [[1, [3, 4]]])
rel rember_test_8(q) {
    rember([2], [1, [2], [3, 4]], q)
}

// Test rember with complex nested structure
@test(expected = [[[1, [2]], [4]]])
rel rember_test_9(q) {
    rember([3], [[1, [2]], [3], [4]], q)
}

// Empty lists are permutations → true
@test
rel permute_test_1() {
    permute([], [])
}

// Single element lists are permutations → true
@test
rel permute_test_2() {
    permute([1], [1])
}

// [1, 2] and [2, 1] are permutations → true
@test
rel permute_test_3() {
    permute([1, 2], [2, 1])
}

// [1, 2, 3] and [3, 1, 2] are permutations → true
@test
rel permute_test_4() {
    permute([1, 2, 3], [3, 1, 2])
}

// [1, 2] and [1, 3] are not permutations → no results
@test(expected = [])
rel permute_test_5(result) {
    permute([1, 2], [1, 3]),
    result == true
}

// [1, 2, 3] and [4, 5, 6] are not permutations → no results
@test(expected = [])
rel permute_test_6(result) {
    permute([1, 2, 3], [4, 5, 6]),
    result == true
}

// [1, 2, 3] and [2, 3, 1] are permutations → true
@test
rel permute_test_7() {
    permute([1, 2, 3], [2, 3, 1])
}

// Test permute with duplicates
@test
rel permute_test_8() {
    permute([1, 1, 2], [2, 1, 1])
}

// Test permute with nested structures
@test
rel permute_test_9() {
    permute([[1, 2], [3]], [[3], [1, 2]])
}

// Test permute with longer list
@test
rel permute_test_10() {
    permute([1, 2, 3, 4], [4, 2, 1, 3])
}

// Empty list is distinct → true
@test
rel distinct_test_1() {
    distinct([])
}

// Single element list is distinct → true
@test
rel distinct_test_2() {
    distinct([1])
}

// Two different elements are distinct → true
@test
rel distinct_test_3() {
    distinct([1, 2])
}

// Two same elements are not distinct → no solutions
@test(expected = [])
rel distinct_test_4(result) {
    distinct([1, 1]),
    result == true
}

// Three different elements are distinct → true
@test
rel distinct_test_5() {
    distinct([1, 2, 3])
}

// Three elements with one duplicate are not distinct → no solutions
@test(expected = [])
rel distinct_test_6(result) {
    distinct([1, 2, 2]),
    result == true
}

// Four different elements are distinct → true
@test
rel distinct_test_7() {
    distinct([1, 2, 3, 4])
}

// Four elements with duplicates are not distinct → no solutions
@test(expected = [])
rel distinct_test_8(result) {
    distinct([1, 2, 3, 2]),
    result == true
}

// Test distinct with nested lists
@test
rel distinct_test_9() {
    distinct([[1, 2], [3, 4], [5]])
}

// Test distinct with nested lists containing duplicates → no solutions
@test(expected = [])
rel distinct_test_10(result) {
    distinct([[1, 2], [3, 4], [1, 2]]),
    result == true
}

// Test reverse with empty list
@test(expected = [[]])
rel reverse_test_1(q) {
    reverse([], q)
}

// Test reverse with single element
@test(expected = [[1]])
rel reverse_test_2(q) {
    reverse([1], q)
}

// Test reverse with multiple elements
@test(expected = [[3, 2, 1]])
rel reverse_test_3(q) {
    reverse([1, 2, 3], q)
}

// Test reverse with nested lists
@test(expected = [[[3, 4], [1, 2]]])
rel reverse_test_4(q) {
    reverse([[1, 2], [3, 4]], q)
}

// Test reverse backward mode (double reverse should give original)
@test
rel reverse_test_5() {
    |rev| {
        reverse([1, 2, 3], rev),
        reverse(rev, [1, 2, 3])
    }
}

// Test length with empty list
@test(expected = [0])
rel length_test_1_basic(n) {
    length([], n)
}

// Test length with single element
@test(expected = [1])
rel length_test_2_basic(n) {
    length([1], n)
}

// Test length with three elements
@test(expected = [3])
rel length_test_3_basic(n) {
    length([1, 2, 3], n)
}

// Test length check (forward mode)
@test
rel length_test_4_basic() {
    length([1, 2, 3], 3)
}

