// =============================================================================
// PATH CONSTRUCTION INTEGRATION TESTS
// =============================================================================

// Test bidirectional path operations
@test(expected = ["path/to/file.txt"])
rel test_path_reconstruction(reconstructed) {
    |path, parent, filename| {
        path == "path/to/file.txt",
        parent_path(path, parent),
        file_name(path, filename),
        join_path(parent, filename, reconstructed)
    }
}

// Test path component operations
@test
rel test_path_component_roundtrip() {
    |path, components, rebuilt| {
        path == "home/user/docs/file.txt",
        path_components(path, components),
        join_paths(components, rebuilt),
        rebuilt == path
    }
}

// Test extension manipulation
@test(expected = ["path/to/file.md"])
rel test_with_extension(result) {
    with_extension("path/to/file.txt", "md", result)
}

// =============================================================================
// EDGE CASE TESTS
// =============================================================================

// Test root path handling
@test(expected = ["/"])
rel test_parent_of_root(result) {
    parent_path("/", result)
}

// Test filename with no extension
@test(expected = ["README"])
rel test_file_stem_no_extension(result) {
    file_stem("path/to/README", result)
}

// Test empty extension
@test(expected = [""])
rel test_extension_none(result) {
    extension("path/to/README", result)
}

// Test dot files
@test(expected = [".bashrc"])
rel test_dotfile_name(result) {
    file_name("home/user/.bashrc", result)
}

@test(expected = [".bashrc"])
rel test_dotfile_stem(result) {
    file_stem("home/user/.bashrc", result)
}