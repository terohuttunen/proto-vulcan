// Path Manipulation Test Suite
// Tests for std::path module functionality

use std::path::*;

// =============================================================================
// PATH CONSTRUCTION TESTS
// =============================================================================

// Test path joining
@test(expected = ["home/user/file.txt"])
rel test_join_path_simple(result) {
    join_path("home/user", "file.txt", result)
}

// Test multiple path joining
@test(expected = ["home/user/docs/file.txt"])
rel test_join_paths_multiple(result) {
    join_paths(["home", "user", "docs", "file.txt"], result)
}

// Test joining empty list
@test(expected = [""])
rel test_join_paths_empty(result) {
    join_paths([], result)
}

// Test joining single component
@test(expected = ["single.txt"])
rel test_join_paths_single(result) {
    join_paths(["single.txt"], result)
}

// =============================================================================
// PATH DECOMPOSITION TESTS
// =============================================================================

// Test file extension operations
@test(expected = ["file"])
rel test_file_stem(result) {
    file_stem("path/to/file.txt", result)
}

@test(expected = ["txt"])
rel test_extension(result) {
    extension("path/to/file.txt", result)
}

// Test filename extraction
@test(expected = ["file.txt"])
rel test_file_name(result) {
    file_name("path/to/file.txt", result)
}

// Test parent path extraction
@test(expected = ["path/to"])
rel test_parent_path(result) {
    parent_path("path/to/file.txt", result)
}

// =============================================================================
// PATH PROPERTIES TESTS
// =============================================================================

// Test extension checking
@test
rel test_has_extension_positive() {
    has_extension("file.txt", "txt")
}

@test(expected = [])
rel test_has_extension_negative(result) {
    has_extension("file.txt", "md"),
    result == true
}

// Test relative path checking
@test
rel test_is_relative_path() {
    is_relative_path("docs/file.txt")
}

// =============================================================================
// PATH MANIPULATION TESTS
// =============================================================================

// Test suffix addition
@test(expected = ["file_backup.txt"])
rel test_add_suffix(result) {
    |parent, name, full_path, result_path| {
        parent == "path/to",
        name == "file.txt",
        join_path(parent, name, full_path),
        add_suffix(full_path, "_backup", result_path),
        file_name(result_path, result)
    }
}

// Test absolute path creation
@test(expected = ["/home/user/docs/file.txt"])
rel test_absolute_path_relative(result) {
    absolute_path("docs/file.txt", "/home/user", result)
}

// Test absolute path with already absolute input - expect just one result
@test
rel test_absolute_path_already_absolute() {
    |result| {
        absolute_path("/absolute/path/file.txt", "/some/base", result),
        result == "/absolute/path/file.txt"
    }
}

// =============================================================================
// PATH UTILITIES TESTS
// =============================================================================

// Test ancestors generation
@test(expected = [["path/to", "path"]])
rel test_ancestors(result) {
    ancestors("path/to/file.txt", result)
}

