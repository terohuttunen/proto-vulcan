// tests/language_features.pv
use std::list::*;

// --- Conjunction Tests (AND) ---

@test
rel conjunction_succeeds() {
    // Both goals must succeed for the conjunction to succeed.
    assert_eq(1, 1),
    assert_eq("a", "a")
}

@test(should_fail)
rel conjunction_fails_on_second_goal() {
    // The first goal succeeds, but the second one fails.
    assert_eq(1, 1),
    assert_eq(1, 2)
}

// --- Disjunction Tests (OR) ---

@test
rel disjunction_succeeds_on_first_branch() {
    // Match provides a way to express disjunction.
    // This test succeeds because the first branch is taken.
    match 1 {
        1 => assert_eq(1, 1),
        2 => assert_eq(1, 2)
    }
}

@test
rel disjunction_succeeds_on_second_branch() {
    // This test succeeds because the second branch is taken.
    match 2 {
        1 => assert_eq(1, 2),
        2 => assert_eq(1, 1)
    }
}

@test(should_fail)
rel disjunction_fails_on_no_match() {
    // This test fails because neither branch of the match can succeed.
    match 3 {
        1 => true,
        2 => true
    }
}

// Port of test_conde_1 from src/operator/conde.rs
// This test verifies that the 'any' operator (disjunction) correctly interleaves
// solutions from multiple member relations in the expected order: 1, 4, 2, 7, 3, 5, 8, 6, 9
@test(expected = [1, 4, 2, 7, 3, 5, 8, 6, 9])
rel test_interleaving_order(q) {
    any {
        member(q, [1, 2, 3]),
        member(q, [4, 5, 6]),
        member(q, [7, 8, 9])
    }
} 