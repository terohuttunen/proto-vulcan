// tests/language_features.pv
use std::list::*;

// --- Conjunction Tests (AND) ---

@test
rel conjunction_succeeds() {
    // Both goals must succeed for the conjunction to succeed.
    assert_eq(1, 1),
    assert_eq("a", "a")
}

@test(should_fail)
rel conjunction_fails_on_second_goal() {
    // The first goal succeeds, but the second one fails.
    assert_eq(1, 1),
    assert_eq(1, 2)
}

// --- Disjunction Tests (OR) ---

@test
rel disjunction_succeeds_on_first_branch() {
    // Match provides a way to express disjunction.
    // This test succeeds because the first branch is taken.
    match 1 {
        1 => assert_eq(1, 1),
        2 => assert_eq(1, 2)
    }
}

@test
rel disjunction_succeeds_on_second_branch() {
    // This test succeeds because the second branch is taken.
    match 2 {
        1 => assert_eq(1, 2),
        2 => assert_eq(1, 1)
    }
}

@test(should_fail)
rel disjunction_fails_on_no_match() {
    // This test fails because neither branch of the match can succeed.
    match 3 {
        1 => true,
        2 => true
    }
}

// Port of test_conde_1 from src/operator/conde.rs
// This test verifies that the 'any' operator (disjunction) correctly interleaves
// solutions from multiple member relations in the expected order: 1, 4, 2, 7, 3, 5, 8, 6, 9
@test(expected = [1, 4, 2, 7, 3, 5, 8, 6, 9])
rel test_interleaving_order(q) {
    any {
        member(q, [1, 2, 3]),
        member(q, [4, 5, 6]),
        member(q, [7, 8, 9])
    }
}

// Test DFS (depth-first search) behavior
// With DFS, the any block should explore the first branch completely before moving to the next
// Expected order: 1, 2, 3, 4, 5, 6, 7, 8, 9 (first list completely, then second, then third)
@test(expected = [1, 2, 3, 4, 5, 6, 7, 8, 9])
rel test_dfs_order(q) {
    any(strategy = dfs) {
        member(q, [1, 2, 3]),
        member(q, [4, 5, 6]),
        member(q, [7, 8, 9])
    }
}

// Test DFS with conjunction - verifying that all goals work with DFS
@test
rel test_dfs_conjunction() {
    all(strategy = dfs) {
        assert_eq(1, 1),
        assert_eq(2, 2)
    }
}

// Test relation-level @dfs attribute
// This relation is marked as DFS-only, so it should use depth-first search internally
@test(expected = [1, 2, 3, 4, 5, 6])
rel test_relation_level_dfs(q) @dfs {
    any {
        member(q, [1, 2, 3]),
        member(q, [4, 5, 6])
    }
}

// Test that @bfs relation works in BFS context (should interleave)
@test(expected = [1, 4, 2, 5, 3, 6])
rel test_relation_level_bfs(q) @bfs {
    any {
        member(q, [1, 2, 3]),
        member(q, [4, 5, 6])
    }
}

// Test nested DFS relation call from BFS context (should work - DFS in BFS is legal)
@test(expected = [1, 2, 3, 4, 5, 6])
rel test_dfs_in_bfs(q) {
    test_relation_level_dfs(q)
}

// Test that BFS relation can be called from DFS context 
// Based on logic programming theory: explicit @bfs annotation overrides parent context
// This issues a warning but is allowed - the relation author knows best
@test(expected = [1, 4, 2, 5, 3, 6]) 
rel test_bfs_in_dfs(q) @dfs {
    test_relation_level_bfs(q)
}

// Helper relation for testing inheritance
rel helper_relation_inherits_strategy(q) {
    any {
        member(q, [10, 20]),
        member(q, [30, 40])
    }
}

// Test that helper relations inherit search strategy from calling context
@test(expected = [10, 20, 30, 40])  // DFS order when called from DFS context
rel test_strategy_inheritance(q) @dfs {
    helper_relation_inherits_strategy(q)
} 