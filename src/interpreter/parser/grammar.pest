// =============================================================================
// Proto-vulcan Language Grammar (Corrected and Complete)
// =============================================================================

// -- Whitespace and Comments --
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ line_comment | block_comment }
line_comment  = _{ "//" ~ (!("\n" | EOI) ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// =============================================================================
// Top-Level Program Structure
// =============================================================================

program = {
    SOI ~ (use_statement | mod_definition | struct_definition | impl_block | relation_definition)* ~ EOI
}

mod_definition = {
    "mod" ~ ident ~ search_strategy? ~ "{" ~
        (use_statement | mod_definition | struct_definition | impl_block | relation_definition)*
    ~ "}"
}

struct_definition = {
    pub_keyword? ~ "struct" ~ type_name ~ (tuple_struct_def | named_struct_def)
}

tuple_struct_def = {
    "(" ~ (type_name ~ ("," ~ type_name)*)? ~ ","? ~ ")" ~ ";"
}

named_struct_def = {
    "{" ~ (named_field ~ ("," ~ named_field)*)? ~ ","? ~ "}"
}

named_field = { pub_keyword? ~ ident ~ ":" ~ type_name }

impl_block = {
    "impl" ~ type_name ~ "{" ~
        (relation_definition)*
    ~ "}"
}

// =============================================================================
// Imports
// =============================================================================

use_statement = { "use" ~ use_path ~ ";" }

use_path = {
    path_segment ~ ("::" ~ (path_segment | glob | list_import))*
}

path_segment = { ident }
glob = { "*" }
list_import = { "{" ~ (import_item ~ ("," ~ import_item)*)? ~ ","? ~ "}" }
import_item = { ident ~ ("as" ~ ident)? }

// =============================================================================
// Definitions
// =============================================================================

relation_definition = {
    attribute* ~ pub_keyword? ~ "rel" ~ ident ~ "(" ~ (parameter ~ ("," ~ parameter)*)? ~ ","? ~ ")" ~ search_strategy? ~ "{" ~
        goal_body
    ~ "}"
}

parameter = { ident ~ (":" ~ type_name)? }
type_name = { ident }
pub_keyword = { "pub" }
attribute = { "@" ~ ident ~ ("(" ~ attribute_args? ~ ")")? }
attribute_args = { attribute_arg ~ ("," ~ attribute_arg)* ~ ","? }
attribute_arg = { named_attribute_arg | flag_attribute_arg }
named_attribute_arg = { ident ~ "=" ~ term }
flag_attribute_arg = { ident }

// =============================================================================
// Goal Structures
// =============================================================================

goal_body = { (goal ~ ("," | ";")?)* }

goal = {
    let_declaration |
    fresh_variables |
    any_block |
    all_block |
    pattern_matching |
    equality_goal |
    disequality_goal |
    method_call |
    call_expr |
    parenthesized_goal
}

// -- Variable Declarations --
let_declaration = { "let" ~ ident ~ ("=" ~ term)? ~ ";" }
fresh_variables = { "|" ~ (ident ~ ("," ~ ident)*)? ~ "|" ~ "{" ~ goal_body ~ "}" }

// -- Control Flow --
any_block = {
    "any" ~ search_params? ~ "{" ~ goal_body ~ "}"
}

all_block = {
    "all" ~ search_params? ~ "{" ~ goal_body ~ "}"
}

search_strategy = { "@" ~ strategy_value }

search_params = {
    "(" ~ search_param ~ ("," ~ search_param)* ~ ","? ~ ")"
}

search_param = _{
    strategy_param |
    limit_param |
    depth_param |
    custom_param
}

strategy_value = @{ "bfs" | "dfs" }
strategy_param = { "strategy" ~ "=" ~ (strategy_value | ident) }
limit_param = { "limit" ~ "=" ~ (number_literal | string_literal) }
depth_param = { "depth" ~ "=" ~ (number_literal | string_literal) }
custom_param = { ident ~ "=" ~ param_value }

param_value = { number_literal | string_literal | boolean_literal | ident }

pattern_matching = { "match" ~ term ~ "{" ~ (pattern_arm ~ ("," ~ pattern_arm)* ~ ","?)? ~ "}" }
pattern_arm = { pattern ~ "=>" ~ (goal | "{" ~ goal_body ~ "}") }
parenthesized_goal = { "(" ~ goal_body ~ ")" }

// -- Basic Goals --
equality_goal = { term ~ "==" ~ term }
disequality_goal = { term ~ "!=" ~ term }
method_call = { term ~ "." ~ ident ~ "(" ~ (term ~ ("," ~ term)*)? ~ ")" }
call_expr = { path ~ "(" ~ (term ~ ("," ~ term)*)? ~ ","? ~ ")" }

// =============================================================================
// Terms and Patterns
// =============================================================================

term = {
    literal |
    list_construction |
    named_struct_construction |
    call_expr |
    parenthesized_term |
    path_term |
    variable
}

parenthesized_term = { "(" ~ term ~ ")" }

// -- Patterns (used in `match` arms) --
pattern = {
    literal |
    wildcard |
    list_pattern |
    named_struct_pattern |
    compound_pattern_with_parens |
    compound_pattern_no_parens |
    variable
}

wildcard = { "_" }

list_pattern = { "[" ~ (pattern_list)? ~ "]" }
pattern_list = { (pattern ~ ("," ~ pattern)* ~ (list_tail)?) | list_tail }
list_tail = { "|" ~ pattern }

named_struct_pattern = {
    ident ~ "{" ~ (field_pattern ~ ("," ~ field_pattern)*)? ~ ","? ~ "}"
}
field_pattern = { ident ~ ":" ~ pattern }

path = @{ ident ~ ("::" ~ ident)* }
compound_pattern_with_parens = { path ~ "(" ~ (pattern ~ ("," ~ pattern)*)? ~ ","? ~ ")" }
compound_pattern_no_parens = @{ ident ~ ("::" ~ ident)+ }

// -- Term/Pattern Components --
literal = { boolean_literal | number_literal | string_literal | char_literal }
path_term = @{ ident ~ ("::" ~ ident)+ }
variable = @{ ident }
list_construction = { "[" ~ term_list? ~ "]" }
term_list = { term ~ ("," ~ term)* ~ term_tail? }
term_tail = { "|" ~ term }
named_struct_construction = {
    ident ~ "{" ~ (field_initializer ~ ("," ~ field_initializer)*)? ~ ","? ~ "}"
}
field_initializer = { ident ~ ":" ~ term }

// =============================================================================
// Lexical Elements
// =============================================================================

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
boolean_literal = @{ "true" | "false" }
number_literal = @{ "-"? ~ ASCII_DIGIT+ }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
char_literal = @{ "'" ~ (!"'" ~ ANY) ~ "'" } 