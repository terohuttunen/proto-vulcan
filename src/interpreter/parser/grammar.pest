// =============================================================================
// Proto-vulcan Language Grammar (Corrected and Complete)
// =============================================================================

// -- Whitespace and Comments --
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ line_comment | block_comment }
line_comment  = _{ "//" ~ (!("\n" | EOI) ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// =============================================================================
// Atomic Operators (for better error reporting)
// =============================================================================

// Keep only the most critical atomic operators that prevent confusion
equality_op = @{ "==" }
inequality_op = @{ "!=" }
pattern_arrow = @{ "=>" }

// =============================================================================
// Top-Level Program Structure
// =============================================================================

program = {
    SOI ~ (extern_crate_statement | use_statement | mod_declaration | struct_definition | enum_definition | impl_block | predicate_definition)* ~ EOI
}

// Module declarations
mod_declaration = {
    mod_declaration_body | mod_declaration_simple
}

mod_declaration_body = {
    visibility? ~ mod_keyword ~ ident ~ search_strategy? ~ "{" ~
        (extern_crate_statement | use_statement | mod_declaration | struct_definition | enum_definition | impl_block | predicate_definition)*
    ~ "}"
}

mod_declaration_simple = {
    visibility? ~ mod_keyword ~ ident ~ ";"
}

// Visibility system
visibility = {
    pub_keyword ~ ("(" ~ visibility_scope ~ ")")?
}

visibility_scope = {
    crate_keyword | super_keyword | self_keyword | qualified_path
}

// Path system for qualified names (ordered from most specific to most general)
qualified_path = {
    absolute_path | crate_path | super_path | self_path | relative_path | external_path
}

absolute_path = { path_sep ~ simple_segments }
crate_path = { crate_keyword ~ (path_sep ~ simple_segments)? }
super_path = { super_keyword ~ (path_sep ~ simple_segments)? }
self_path = { self_keyword ~ (path_sep ~ simple_segments)? }
external_path = { ident ~ path_sep ~ simple_segments }
relative_path = { simple_segments }

path_sep = @{ "::" }
simple_segments = { ident ~ (path_sep ~ ident)* }

// Keywords
crate_keyword = @{ "crate" }
super_keyword = @{ "super" }
self_keyword = @{ "self" }
mod_keyword = @{ "mod" }
use_keyword = @{ "use" }
extern_keyword = @{ "extern" }
as_keyword = @{ "as" }
struct_keyword = @{ "struct" }
enum_keyword = @{ "enum" }

struct_definition = {
    visibility? ~ struct_keyword ~ type_name ~ (tuple_struct_def | named_struct_def)
}

tuple_struct_def = {
    "(" ~ (type_name ~ ("," ~ type_name)*)? ~ ","? ~ ")" ~ ";"
}

named_struct_def = {
    "{" ~ (named_field ~ ("," ~ named_field)*)? ~ ","? ~ "}"
}

named_field = { visibility? ~ ident ~ ":" ~ type_name }

// Enum definitions
enum_definition = {
    visibility? ~ enum_keyword ~ type_name ~ "{" ~ (enum_variant ~ ("," ~ enum_variant)*)? ~ ","? ~ "}"
}

enum_variant = {
    ident ~ (enum_variant_tuple | enum_variant_named)?
}

enum_variant_tuple = {
    "(" ~ (type_name ~ ("," ~ type_name)*)? ~ ","? ~ ")"
}

enum_variant_named = {
    "{" ~ (named_field ~ ("," ~ named_field)*)? ~ ","? ~ "}"
}

impl_block = {
    "impl" ~ type_name ~ "{" ~
        (predicate_definition)*
    ~ "}"
}

// =============================================================================
// Imports
// =============================================================================

// External crate declaration
extern_crate_statement = { extern_keyword ~ crate_keyword ~ ident ~ (as_keyword ~ ident)? ~ ";" }

use_statement = { use_keyword ~ use_path ~ ";" }

use_path = {
    use_path_glob | use_path_list | use_path_simple
}

use_path_simple = { use_path_base }
use_path_glob = { use_path_base ~ path_sep ~ glob }
use_path_list = { use_path_base ~ path_sep ~ list_import }

use_path_base = {
    qualified_path
}

path_segment = { ident }
glob = { "*" }
list_import = { "{" ~ (import_item ~ ("," ~ import_item)*)? ~ ","? ~ "}" }
import_item = { ident ~ ("as" ~ ident)? }

// =============================================================================
// Definitions
// =============================================================================

predicate_definition = {
    attribute* ~ visibility? ~ predicate_keyword ~ ident ~ "(" ~ (parameter ~ ("," ~ parameter)*)? ~ ","? ~ ")" ~ search_strategy? ~ "{" ~
        goal_body
    ~ "}"
}

predicate_keyword = @{ "macro" | "rel" }

parameter = { ident ~ (":" ~ meta_type_annotation)? }
meta_type_annotation = { relation_type | "int" | "string" | "bool" | type_name }
relation_type = { "rel" ~ "(" ~ number_literal ~ ")" }
type_name = { qualified_path | ident }
pub_keyword = @{ "pub" }
attribute = { "@" ~ ident ~ ("(" ~ attribute_args? ~ ")")? }
attribute_args = { attribute_arg ~ ("," ~ attribute_arg)* ~ ","? }
attribute_arg = { named_attribute_arg | flag_attribute_arg }
named_attribute_arg = { ident ~ "=" ~ term }
flag_attribute_arg = { ident }

// =============================================================================
// Meta Programming Constructs  
// =============================================================================

meta_statement = {
    meta_let_statement |
    meta_if_statement |
    meta_for_statement
}

meta_let_statement = { "let" ~ ident ~ ":" ~ meta_type_annotation ~ "=" ~ meta_expr_content ~ ";" }

meta_if_statement = {
    "if" ~ meta_expr_content ~ "{" ~ goal_body ~ "}" ~ 
    ("else" ~ "if" ~ meta_expr_content ~ "{" ~ goal_body ~ "}")* ~ 
    ("else" ~ "{" ~ goal_body ~ "}")?
}

meta_for_statement = {
    "for" ~ ident ~ ":" ~ meta_type_annotation ~ "in" ~ meta_for_range ~ "{" ~ goal_body ~ "}"
}

meta_for_range = {
    meta_expr_content ~ ".." ~ meta_expr_content
}

meta_expr_content = @{ ( !(";" | "{" | "..") ~ ANY )* }

// =============================================================================
// Interpolation Expression (for goals and terms)
// =============================================================================

interpolation_expression = { "{" ~ interpolation_content ~ "}" }
interpolation_content = @{ ( !("}" | EOI) ~ ANY )* }

// =============================================================================
// Goal Structures
// =============================================================================

goal_body = { (goal ~ ("," | ";")?)* }

goal = {
    constraint_block | // Moved up to prioritize its unique keyword
    meta_statement |   // NEW: Meta programming statements
    let_declaration |
    fresh_variables |
    any_block |
    all_block |
    pattern_matching |
    equality_goal |
    disequality_goal |
    method_call |
    relation_call |
    parenthesized_goal |
    literal
}

// -- Variable Declarations --
let_declaration = { "let" ~ ident ~ ("=" ~ term)? ~ ";" }
fresh_variables = { "|" ~ (ident ~ ("," ~ ident)*)? ~ "|" ~ "{" ~ goal_body ~ "}" }

// -- Control Flow --
any_block = {
    "any" ~ search_params? ~ "{" ~ goal_body ~ "}"
}

all_block = {
    "all" ~ search_params? ~ "{" ~ goal_body ~ "}"
}

// -- Constraint Block --
constraint_block = { "constraint" ~ constraint_params? ~ "{" ~ constraint_body ~ "}" }

constraint_params = {
    "(" ~ constraint_param ~ ("," ~ constraint_param)* ~ ","? ~ ")"
}

constraint_param = _{
    domain_param |
    custom_constraint_param
}

domain_param = { "domain" ~ "=" ~ string_literal }
custom_constraint_param = { ident ~ "=" ~ param_value }

constraint_body = @{ constraint_content* }

// Content within constraint blocks that properly handles balanced braces and strings
constraint_content = _{
    string_literal |           // Handle strings first to ignore braces inside them
    balanced_braces |          // Handle nested braced content
    (!("}" | "{" | "\"") ~ ANY) // Regular content (not brace or quote)
}

// Balanced braces: { ... } where the content can contain more balanced braces
balanced_braces = @{ "{" ~ constraint_content* ~ "}" }

search_strategy = { "@" ~ strategy_value }

search_params = {
    "(" ~ search_param ~ ("," ~ search_param)* ~ ","? ~ ")"
}

search_param = _{
    strategy_param |
    limit_param |
    depth_param |
    custom_param
}

strategy_value = @{ "bfs" | "dfs" }
strategy_param = { "strategy" ~ "=" ~ (strategy_value | ident) }
limit_param = { "limit" ~ "=" ~ (number_literal | string_literal) }
depth_param = { "depth" ~ "=" ~ (number_literal | string_literal) }
custom_param = { ident ~ "=" ~ param_value }

param_value = { number_literal | string_literal | boolean_literal | ident }

pattern_matching = { "match" ~ term ~ "{" ~ (pattern_arm ~ ("," ~ pattern_arm)* ~ ","?)? ~ "}" }
pattern_arm = { pattern ~ pattern_arrow ~ (goal | "{" ~ goal_body ~ "}") }
parenthesized_goal = { "(" ~ goal_body ~ ")" }

// -- Basic Goals --
equality_goal = { term ~ equality_op ~ term }
disequality_goal = { term ~ inequality_op ~ term }
method_call = { term ~ "." ~ ident ~ "(" ~ (term ~ ("," ~ term)*)? ~ ")" }
relation_call = { qualified_path ~ "(" ~ (call_argument ~ ("," ~ call_argument)*)? ~ ","? ~ ")" }

// =============================================================================
// Terms and Patterns
// =============================================================================

// Call arguments can be either terms or arithmetic meta expressions
call_argument = { arithmetic_expr | term }
arithmetic_expr = @{ ident ~ ( " "* ~ ("+" | "-" | "*" | "/") ~ " "* ~ (ident | number_literal) )+ }

term = {
    interpolation_expression | // NEW: {variable} interpolation syntax
    literal |
    wildcard |
    list_construction |
    named_struct_construction |
    named_variant_construction |
    tuple_struct_construction |
    parenthesized_term |
    path_term |
    tuple_struct_construction_no_parens |
    variable
}

// Struct and enum variant term construction
tuple_struct_construction = { qualified_path ~ "(" ~ (term ~ ("," ~ term)*)? ~ ","? ~ ")" }
named_variant_construction = { qualified_path ~ "{" ~ (field_initializer ~ ("," ~ field_initializer)*)? ~ ","? ~ "}" }
tuple_struct_construction_no_parens = { qualified_path }

parenthesized_term = { "(" ~ term ~ ")" }

// -- Patterns (used in `match` arms) --
pattern = {
    literal |
    wildcard |
    list_pattern |
    named_struct_pattern |
    named_variant_pattern |
    tuple_struct_pattern_with_parens |
    tuple_struct_pattern_no_parens |
    variable
}

wildcard = { "_" }

list_pattern = { "[" ~ (pattern_list)? ~ "]" }
pattern_list = { (pattern ~ ("," ~ pattern)* ~ (list_tail)?) | list_tail }
list_tail = { "|" ~ pattern }

named_struct_pattern = {
    ident ~ "{" ~ (field_pattern ~ ("," ~ field_pattern)*)? ~ ","? ~ "}"
}
named_variant_pattern = {
    qualified_path ~ "{" ~ (field_pattern ~ ("," ~ field_pattern)*)? ~ ","? ~ "}"
}
field_pattern = { ident ~ ":" ~ pattern }

// Use unified qualified_path system for all path contexts
tuple_struct_pattern_with_parens = { qualified_path ~ "(" ~ (pattern ~ ("," ~ pattern)*)? ~ ","? ~ ")" }
tuple_struct_pattern_no_parens = { qualified_path }

// -- Term/Pattern Components --
literal = { boolean_literal | number_literal | string_literal | char_literal }
path_term = { qualified_path }
variable = @{ ident }
list_construction = { "[" ~ term_list? ~ "]" }
term_list = { term ~ ("," ~ term)* ~ term_tail? }
term_tail = { "|" ~ term }
named_struct_construction = {
    ident ~ "{" ~ (field_initializer ~ ("," ~ field_initializer)*)? ~ ","? ~ "}"
}


field_initializer = { ident ~ ":" ~ term }

// =============================================================================
// Lexical Elements
// =============================================================================

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
boolean_literal = @{ "true" | "false" }
number_literal = @{ "-"? ~ ASCII_DIGIT+ }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
char_literal = @{ "'" ~ (!"'" ~ ANY) ~ "'" } 