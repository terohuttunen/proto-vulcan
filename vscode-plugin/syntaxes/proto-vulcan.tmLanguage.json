{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Proto-Vulcan",
    "scopeName": "source.proto-vulcan",
    "patterns": [
        {
            "include": "#keywords"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.proto-vulcan",
                    "match": "\\b(if|else|any_of|all_of|in|match|any|all|let)\\b"
                },
                {
                    "name": "keyword.other.proto-vulcan",
                    "match": "\\b(rel|macro|use|mod|struct|impl|pub|constraint)\\b"
                },
                {
                    "name": "constant.language.boolean.proto-vulcan",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "keyword.operator.logical.proto-vulcan",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "support.function.builtin.proto-vulcan",
                    "match": "\\b(assert_eq|assert_bound|assert_unbound|member|append)\\b"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.proto-vulcan",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.proto-vulcan",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.proto-vulcan",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.proto-vulcan",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.proto-vulcan",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.proto-vulcan",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.proto-vulcan",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.proto-vulcan",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.arithmetic.proto-vulcan",
                    "match": "(\\+|\\-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.assignment.proto-vulcan",
                    "match": "="
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.proto-vulcan",
                    "match": "\\b(int|string|bool|rel)\\b"
                },
                {
                    "name": "entity.name.type.proto-vulcan",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.proto-vulcan",
                    "match": "\\b[a-z][a-zA-Z0-9_]*(?=\\s*\\()"
                },
                {
                    "name": "variable.other.proto-vulcan",
                    "match": "\\b(?!(?:if|else|for|in|match|any|all|let|rel|macro|use|mod|struct|impl|pub|constraint|true|false|and|or|not|assert_eq|assert_bound|assert_unbound|member|append|int|string|bool)\\b)[a-z][a-zA-Z0-9_]*\\b"
                },
                {
                    "name": "variable.language.wildcard.proto-vulcan",
                    "match": "\\b_\\b"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.definition.block.proto-vulcan",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.parameters.proto-vulcan",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.definition.array.proto-vulcan",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.separator.comma.proto-vulcan",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.proto-vulcan",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.pipe.proto-vulcan",
                    "match": "\\|"
                }
            ]
        }
    }
}